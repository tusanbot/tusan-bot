# Telegram bot token from BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=

# Destination channel, e.g. @tusan_channel or -1001234567890
TELEGRAM_CHANNEL_ID=

# Existing Tosan Supabase project (server-side service role key only).
SUPABASE_URL=https://yhbaedfifcxgjxutnyjc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public site origin.
SITE_URL=https://www.tusancn.ir

# Optional until the public news detail route is available. News posts are held back while blank.
# Use {slug} as the placeholder, e.g. https://www.tusancn.ir/news/{slug}
NEWS_URL_TEMPLATE=

# Verified direct service request route. Use {slug} as the placeholder.
SERVICE_REQUEST_URL_TEMPLATE=https://www.tusancn.ir/services/{slug}

# Source reconciliation interval. Default: 300000 (5 minutes).
SOURCE_POLL_INTERVAL_MS=300000

# Queue recovery polling interval. Default: 30000 (30 seconds); Realtime is primary.
QUEUE_POLL_INTERVAL_MS=30000

# Maximum number of jobs handled per worker batch.
QUEUE_BATCH_SIZE=10

# All user-facing dates are rendered in Asia/Tehran.
TZ=Asia/Tehran
